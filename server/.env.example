# ==============================================================================
# YOX ECOMMERCE SERVER — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in real values before running the server.
# NEVER commit your actual .env file or real secret values.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/yox-ecommerce
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/yox-ecommerce-test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ── JWT (minimum 32 characters each; generate with: openssl rand -hex 32) ─────
JWT_ACCESS_SECRET=replace_with_at_least_32_character_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_character_random_refresh_secret
JWT_RESET_SECRET=replace_with_at_least_32_character_random_reset_secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=15m

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Logging & Rate Limiting ───────────────────────────────────────────────────
LOG_LEVEL=debug
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=15
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=30
REPORTS_RATE_LIMIT_WINDOW_MS=60000
REPORTS_RATE_LIMIT_MAX_REQUESTS=20
BCRYPT_SALT_ROUNDS=12

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Keep TEST MODE (rzp_test_...) until all security phases and staging QA pass.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Generated when creating a webhook in Razorpay Dashboard -> Webhooks -> Secret.
# Optional at server boot (defaults to ''), but REQUIRED for POST /api/v1/payments/webhook/razorpay
# (missing secret causes all Razorpay webhook requests to be rejected with HTTP 401).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── MSG91 OTP Widget ──────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_WIDGET_ID=your_msg91_widget_id_here

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_api_user_email
SHIPROCKET_PASSWORD=your_shiprocket_api_user_password
# Generated/configured in Shiprocket Dashboard -> Settings -> API -> Webhooks (x-api-key header).
# Optional at server boot (defaults to ''), but REQUIRED for POST /api/v1/shipments/webhook/courier
# (missing secret causes all Shiprocket webhook requests to be rejected with HTTP 401).
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here
SHIPROCKET_PICKUP_LOCATION_NAME=warehouse
SHIPROCKET_PICKUP_POSTCODE=400051

